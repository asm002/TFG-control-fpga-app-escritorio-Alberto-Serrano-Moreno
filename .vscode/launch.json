{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug C++ with FLTK",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder:final-project-temperature-control-desktop-asm002}\\build\\temperature-control-desktop.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder:final-project-temperature-control-desktop-asm002}\\build",
            "environment": [],
